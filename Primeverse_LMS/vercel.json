{
  "version": 2,
  "builds": [
    {
      "src": "email_service/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "html/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "email_service/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "email_service/main.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily-progression",
      "schedule": "10 7 * * *"
    }
  ]
}
